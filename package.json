{
  "name": "r3f-starter-bun",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot --console src/index.tsx",
    "build": "bun scripts/build.ts",
    "benchmark-strategies": "bun scripts/benchmark-strategies.ts",
    "start": "NODE_ENV=production bun src/index.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bun update --interactive",
    "simulate-match": "bun scripts/simulate-match.ts",
    "unused": "knip"
  },
  "dependencies": {
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "jotai": "^2.20.0",
    "lucide-react": "^1.16.0",
    "mitt": "^3.0.1",
    "p2-es": "^1.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@react-three/eslint-plugin": "^0.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/bun": "1.3.14",
    "bun-plugin-tailwind": "latest",
    "eslint": "^9.39.4",
    "knip": "^5.88.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3"
  }
}
